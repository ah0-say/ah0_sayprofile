{
  "baseURL": "https://ah0-say.github.io/ah0_sayprofile/",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "languageCode": "ko",
  "defaultContentLanguage": "ko",
  "hasCJKLanguage": true,

  "params": {
      "profileMode": {
      "enabled": true,
      "title": "안녕하세요, 아영입니다",
      "subtitle": "전북대학교 컴퓨터공학·인공지능 전공 2학년, 컴퓨터 비전에 관심이 있습니다.",
      "imageUrl": "images/profile2.jpg",
      "imageTitle": "아영 프로필 이미지",
      "imageWidth": 150,
      "imageHeight": 150,
      "buttons": [
        { "name": "소개", "url": "about/" },
        { "name": "활동", "url": "posts/" }
      ]
    },

    "author": "심아영",
    "description": "전북대학교 컴퓨터공학·인공지능 전공 학생 포트폴리오",
    "socialIcons": [
      { "name": "github", "url": "https://github.com/ah0-say" }
    ]
  },
  "title": "아영의 포트폴리오"
}
