{
  "baseURL": "https://ah0-say.github.io/ah0_sayprofile/",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "languageCode": "ko",
  "defaultContentLanguage": "ko",
  "hasCJKLanguage": true,
  "params": {
    "author": "심아영",
    "description": "전북대학교 컴퓨터공학·인공지능 전공 학생 포트폴리오",
    "socialIcons": [
      { "name": "github", "url": "https://github.com/ah0-say" }
    ]
  },
  "title": "아영의 포트폴리오"
}
